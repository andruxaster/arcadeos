#!/bin/sh
set -e
lb config noauto \
  --mode debian \
  --distribution @SUITE@ \
  --mirror-bootstrap @MIRROR@ \
  --mirror-binary @MIRROR@ \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders grub-efi \
  --debian-installer none \
  --memtest none \
  --firmware-chroot true \
  --iso-volume ARCADEOS_INSTALL \
  --iso-application "ArcadeOS Installer" \
  --bootappend-live "boot=live components quiet splash loglevel=3 vt.global_cursor_default=0 username=installer" \
  "${@}"
