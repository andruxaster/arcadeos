# ArcadeOS build configuration
# Sourced by build.sh and every build/*.sh stage.

ARCADEOS_VERSION="0.1.0"

# --- Debian base -----------------------------------------------------------
DEBIAN_SUITE="trixie"                       # Debian 13
DEBIAN_MIRROR="http://deb.debian.org/debian"
DEBIAN_SECURITY="http://security.debian.org/debian-security"

# NVIDIA kernel module flavour: nvidia-kernel-dkms (proprietary)
# or nvidia-open-kernel-dkms (open modules, Turing+ incl. RTX 3050)
NVIDIA_KMOD="nvidia-kernel-dkms"

# --- Secure Boot -----------------------------------------------------------
# Add Microsoft UEFI CA 2011/2023 to db.
#   1 = GPU option ROM (GOP) of a discrete card loads -> picture at POST.
#       Downside: anything signed by Microsoft's 3rd-party CA also boots
#       (e.g. another distro's shim). Lock BIOS + disable USB boot!
#   0 = only your own keys. Stronger, but on PCs without an iGPU the screen
#       may stay black until you reset the firmware (CMOS) - test carefully.
SB_MS_UEFI_CA=1
SB_MS_CERT_URLS=(
  "https://www.microsoft.com/pkiops/certs/MicCorUEFCA2011_2011-06-27.crt"
  "https://www.microsoft.com/pkiops/certs/microsoft%20uefi%20ca%202023.crt"
)
# Common name prefix for generated keys
SB_KEY_CN="ArcadeOS"

# shim built from source with OUR certificate as vendor cert
# (stock Debian shim would also trust Debian-signed GRUB -> bypass).
SHIM_VERSION="16.1"
SHIM_URL="https://github.com/rhboot/shim/releases/download/${SHIM_VERSION}/shim-${SHIM_VERSION}.tar.bz2"

# --- Image layout ----------------------------------------------------------
ESP_SIZE_MIB=512
ROOT_PART_MIB=12288          # LUKS partition for squashfs+verity (headroom for updates)

# Extra kernel command line (roothash etc. are added automatically)
KERNEL_CMDLINE_EXTRA="quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=false vt.global_cursor_default=0 nvidia-drm.modeset=1 sysrq_always_enabled=0"

# --- Users / debug ---------------------------------------------------------
ARCADE_UID=1000
# Non-empty => root gets this password and tty2 gets a login prompt.
# NEVER set for a "production" build.
DEBUG_ROOT_PASSWORD=""

# --- linuxloader -----------------------------------------------------------
# Source: git submodule vendor/linuxloader, built by build/05-linuxloader.sh
# in an Ubuntu chroot that matches upstream CI.
LL_BUILD_SUITE="jammy"                       # Ubuntu 22.04, same as upstream CI
LL_BUILD_MIRROR="http://archive.ubuntu.com/ubuntu"
# Set to a directory with a prebuilt release (./linuxloader + ll-deps/) to skip
# building from source, e.g. LINUXLOADER_PREBUILT="vendor/linuxloader-bin"
LINUXLOADER_PREBUILT=""

# --- Paths -----------------------------------------------------------------
WORK_DIR="work"
OUT_DIR="out"
KEYS_DIR="keys"              # KEEP SAFE. Losing it = you can't sign updates.
