# 32-bit runtime libraries for Lindbergh ELF games.
# Installed one by one: a missing name only prints a warning.
# Most of these are also shipped in linuxloader's own ll-deps/ folder.
libc6:i386
libstdc++6:i386
libgl1:i386
libglu1-mesa:i386
libglut3.12:i386
libopenal1:i386
libxmu6:i386
libsdl2-2.0-0:i386
libfaudio0:i386
libncurses6:i386
libasound2t64:i386
libasound2-plugins:i386
libxrandr2:i386
libxi6:i386
libxxf86vm1:i386
# runtime deps of linuxloader.so / SDL3 (see build/05-linuxloader.sh)
libudev1:i386
libxcursor1:i386
libfreetype6:i386
libharfbuzz0b:i386
libpcsclite1:i386
zlib1g:i386
libx11-6:i386
libxext6:i386
libxss1:i386
libxtst6:i386
libdbus-1-3:i386
libpulse0:i386
libsndio7.0:i386
